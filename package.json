{
  "name": "cams",
  "version": "0.0.0",
  "private": true,
  "description": "Viewer for Reolink cameras: live view, recordings, events and downloads behind Google sign-in.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.mts",
    "check": "tsc --noEmit -p web/tsconfig.json",
    "start": "node dist/server/server.js",
    "dev": "tsx --env-file=.env server/server.ts",
    "dev:web": "vite --config web/vite.config.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "jsdom": "^30.1.1",
    "supertest": "^7.3.0",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
