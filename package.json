{
  "name": "cams",
  "version": "0.0.0",
  "private": true,
  "description": "Viewer for Reolink cameras: live view, recordings, events and downloads behind Google sign-in.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.mts",
    "check": "tsc --noEmit -p web/tsconfig.json",
    "start": "node dist/server/server.js",
    "dev": "tsx --env-file=.env server/server.ts",
    "dev:web": "vite --config web/vite.config.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:times": "tsx scripts/e2e-time-of-day.ts",
    "icons": "node scripts/gen-icons.mjs",
    "check:svelte": "sh scripts/check-svelte.sh",
    "lint:types": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "cam-sim": "https://github.com/klaushofrichter/cam-sim/releases/download/v2026.10.20.1/cam-sim-v2026.10.20.1.tgz",
    "jsdom": "^30.1.3",
    "mpegts.js": "^1.8.2",
    "supertest": "^7.3.1",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
