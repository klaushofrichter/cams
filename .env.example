# Copy to .env for `npm run dev`. Values here are placeholders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
ALLOWED_EMAILS=klaus@klaushofrichter.net
COOKIE_SECRET=
# Optional token sign-in (24+ characters), with or without the GOOGLE_* lines
# above; the Pi demo kit uses it alone (docs/pi-demo.md).
# CAMS_LOGIN_TOKEN=
# COOKIE_SECURE=false
# Path to a JSON list of cameras: [{"id","name","host","user","password"}],
# optional "protocol", "tlsServername", "webUiUrl", "webUiNote", "proxy" (README, Cameras).
CAMERAS_FILE=
LOG_LEVEL=debug
